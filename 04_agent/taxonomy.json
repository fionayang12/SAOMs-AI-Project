    },
    "drop_peripheral_effect": {
      "class": "institutional"
    },
    "wave_design_choice": {
      "class": "institutional"
    },
    "data_construction_heuristic": {
      "class": "institutional"
    },
    "change_global_threshold": {
      "class": "institutional"
    },
    "exclude_unstable_network": {
      "class": "normative"
    },
    "choose_specification": {
      "class": "normative"
    },
    "drop_theory_bearing_effect": {
      "class": "normative"
    },
    "admit_respecified_network": {
      "class": "normative"
    },
    "retain_low_jaccard_network": {
      "class": "normative"
